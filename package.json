{
  "name": "comq-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm typecheck && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
